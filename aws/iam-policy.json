{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeClaude",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:ap-northeast-2::foundation-model/anthropic.claude-3-haiku-20240307-v1:0"
      ]
    },
    {
      "Sid": "MarketplaceSubscriptionForBedrock",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:ViewSubscriptions",
        "aws-marketplace:Subscribe"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DynamoDBDataAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard",
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard/index/*",
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard-logs",
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard-logs/index/*",
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard-config"
      ]
    },
    {
      "Sid": "DynamoDBAutoCreateTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard",
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard-logs",
        "arn:aws:dynamodb:ap-northeast-2:688886174048:table/cerberus-leaderboard-config"
      ]
    }
  ]
}