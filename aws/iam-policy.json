{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeClaude",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-haiku-20240307-v1:0"
      ]
    },
    {
      "Sid": "DynamoDBDataAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard",
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard/index/*",
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard-logs",
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard-logs/index/*",
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard-config"
      ]
    },
    {
      "Sid": "DynamoDBAutoCreateTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard",
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard-logs",
        "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/cerberus-leaderboard-config"
      ]
    },
    {
      "Sid": "KMSForEncryptedTables",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": [
        "<KMS_KEY_ARN>"
      ]
    }
  ]
}
