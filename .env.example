# ──────────────────────────────────────────────
# Cerberus: The Dark Auditor - 환경 변수 템플릿
# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  (.env 는 git 에 커밋되지 않습니다)
# ──────────────────────────────────────────────

# ─── AWS 자격 증명 ───
# 로컬에서 IAM 사용자 키로 테스트하려면 아래 주석을 풀고 값을 채우세요.
# AWS CLI 프로파일이나 EC2/Lambda IAM Role 을 사용하면 비워 두어도 됩니다.
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 임시 자격 증명(STS/SSO)을 사용할 때만 주석 해제
# AWS_SESSION_TOKEN=

# ─── AWS 리소스 설정 ───
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
DYNAMODB_TABLE_NAME=cerberus-leaderboard

# ─── 게임 설정 ───
TIME_LIMIT=300
P_MAX=15
W_TIME=1
W_PROMPT=10
